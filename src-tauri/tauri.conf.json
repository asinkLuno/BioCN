{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BioCN",
  "version": "0.4.1",
  "identifier": "io.github.asinkluno.biocn",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BioCN",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' blob:; img-src 'self' data: blob:; media-src blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline' blob:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/library/files/*.epub"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
